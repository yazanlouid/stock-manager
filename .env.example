# Copy this file to .env (gitignored) and set your own password.
# Docker Compose reads the POSTGRES_* values; the API reads DATABASE_URL.
# Keep the user, password and database name in DATABASE_URL in step with them.

POSTGRES_USER=stock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stock

# 127.0.0.1, not localhost: Postgres is published on IPv4 loopback only, and on
# Windows localhost resolves to ::1 first, where the connection hangs.
DATABASE_URL=postgresql+psycopg://stock:change-me@127.0.0.1:5432/stock
